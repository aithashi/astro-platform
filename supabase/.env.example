# Edge Function secrets. Local: copy to supabase/functions/.env (git-ignored) and run `pnpm functions:serve`.
# Hosted: `pnpm exec supabase secrets set --env-file supabase/functions/.env`.
APP_ORIGIN=http://localhost:5173

# Meta WhatsApp Cloud API (Meta App Dashboard > WhatsApp > API Setup / App settings > Basic)
WHATSAPP_VERIFY_TOKEN=choose-a-long-random-string
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Razorpay (Dashboard > Account & Settings > API keys / Webhooks). Use test-mode keys first.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Signing secret for magic links sent on WhatsApp
LINK_SIGNING_SECRET=
